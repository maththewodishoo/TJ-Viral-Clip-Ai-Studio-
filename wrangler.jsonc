{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tj-viral-clip-ai-studio",
  "main": "worker/index.ts",
  "compatibility_date": "2025-01-01",
  "observability": { "enabled": true },
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "tj_viral_clip_studio",
      "database_id": "REPLACE_WITH_D1_DATABASE_ID",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "tj-viral-clip-studio-media"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "CACHE",
      "id": "REPLACE_WITH_KV_NAMESPACE_ID"
    }
  ],
  "vars": {
    "ALLOWED_ORIGIN": "https://your-domain.example"
  }
  // Secrets (set with `wrangler secret put`):
  //   GEMINI_API_KEY, OPENROUTER_API_KEY, OPENAI_API_KEY, GROQ_API_KEY,
  //   ANTHROPIC_API_KEY, ELEVENLABS_API_KEY, API_AUTH_TOKEN,
  //   PROCESSOR_URL, PROCESSOR_TOKEN
}
