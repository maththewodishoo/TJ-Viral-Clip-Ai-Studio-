# TJ Viral Clip AI Studio — environment example
# The frontend is browser-first: users add their own AI keys in the app UI.
# Copy any needed values into .env / .env.local (never commit real secrets).

# Optional: Cloudflare Worker API base used for proxy mode / server-side keys
# Example: https://tj-viral-clip-ai-studio.your-name.workers.dev
VITE_CLOUD_API_BASE=

# ---------------------------------------------------------------------------
# Worker secrets (never commit real values). Set with:
#   wrangler secret put GEMINI_API_KEY
# ---------------------------------------------------------------------------
GEMINI_API_KEY=
OPENROUTER_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=
ANTHROPIC_API_KEY=
ELEVENLABS_API_KEY=

# Restrict CORS to your deployed frontend origin
ALLOWED_ORIGIN=https://your-domain.example

# Optional shared bearer token for all /api routes
API_AUTH_TOKEN=

# Optional external ffmpeg/yt-dlp processing service (Workers cannot run ffmpeg)
PROCESSOR_URL=
PROCESSOR_TOKEN=
